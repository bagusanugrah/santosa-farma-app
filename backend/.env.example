# ==============================================================================
# KONFIGURASI ENVIRONTMENT — BACKEND APOTEK SANTOSA FARMA
# ==============================================================================
# Salin file ini menjadi `.env` di folder backend/ :
# cp .env.example .env
# Kemudian jalankan: php artisan key:generate
# ==============================================================================

# --- APLIKASI DASAR ---
APP_NAME="Apotek Santosa Farma"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE (SQLITE) ---
# Default menggunakan SQLite lokal: database/database.sqlite
# Pastikan file database/database.sqlite ada (touch database/database.sqlite)
DB_CONNECTION=sqlite
# Jika ingin beralih ke MySQL, aktifkan baris di bawah:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=apotek_santosa_farma
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# --- EMAIL / SMTP (GMAIL) ---
# Digunakan untuk mengirimkan kode OTP email & tautan reset password.
# PANDUAN GMAIL:
# 1. Buka Akun Google -> Keamanan -> Aktifkan "Verifikasi 2 Langkah".
# 2. Buat "Sandi Aplikasi" (App Password) 16 karakter: https://myaccount.google.com/apppasswords
# 3. Masukkan 16 karakter tersebut tanpa spasi ke MAIL_PASSWORD di bawah.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email_anda@gmail.com
MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="email_anda@gmail.com"
MAIL_FROM_NAME="Apotek Santosa Farma"

# --- MIDTRANS PAYMENT GATEWAY ---
# Dapatkan dari Dashboard Midtrans: https://dashboard.midtrans.com/ -> Settings -> Access Keys
# Default adalah mode Sandbox (Testing)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# --- WHATSAPP GATEWAY (FONNTE) ---
# Digunakan untuk mengirim kode OTP pendaftaran/login via WhatsApp.
# Dapatkan token gratis dari https://fonnte.com/ -> Device -> Tambah Device & Scan QR
WA_GATEWAY_TOKEN=token_fonnte_anda_disini
WA_GATEWAY_URL=https://api.fonnte.com/send

# --- NGROK CONFIGURATION (OPSIONAL UNTUK DESKTOP ELECTRON / EXPOSING) ---
# Digunakan oleh aplikasi Desktop Electron agar kasir HP Android bisa mengakses backend dari jaringan luar.
# Dapatkan dari https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-static-domain.ngrok-free.dev
