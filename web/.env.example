# ==============================================================================
# KONFIGURASI ENVIRONTMENT — WEB CLIENT (PELANGGAN) APOTEK SANTOSA FARMA
# ==============================================================================
# Salin file ini menjadi `.env.local` di folder web/ :
# cp .env.example .env.local
# ==============================================================================

# URL API Endpoint Backend Laravel (default: port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Client Key Midtrans Snap (Wajib sama dengan MIDTRANS_CLIENT_KEY di backend)
# Contoh Sandbox: SB-Mid-client-xxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx

