# ==============================================================================
# KONFIGURASI ENVIRONTMENT — DESKTOP ELECTRON APP (KASIR & SUPER ADMIN)
# ==============================================================================
# Salin file ini menjadi `.env.local` di folder desktop/ :
# cp .env.example .env.local
# ==============================================================================

# URL API Endpoint Backend Laravel (default: port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- NGROK CONFIGURATION (OPSIONAL) ---
# Jika diisi, Electron akan otomatis menyalakan tunnel Ngrok dengan static domain saat aplikasi dibuka,
# sehingga aplikasi Android Kasir di HP fisik bisa terhubung ke server kasir desktop.
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-static-domain.ngrok-free.dev
