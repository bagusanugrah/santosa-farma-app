# ==============================================================================
# APOTEK SANTOSA FARMA — ANDROID POS CONFIGURATION (CONTOH TEMPLATE)
# ==============================================================================
# Salin file ini menjadi `.env` di dalam folder android/ :
# cp .env.example .env
#
# Dapatkan kredensial dari Dashboard Supabase:
# Project Settings -> API (URL & Anon/Publishable Key)
# ==============================================================================

# Supabase Cloud Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key (Aman digunakan di client Android)
SUPABASE_ANON_KEY=your-supabase-publishable-key

# Storage Bucket untuk Foto Obat
SUPABASE_PRODUCTS_BUCKET=products
